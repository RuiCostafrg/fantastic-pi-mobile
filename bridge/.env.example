# Copy to .env (never commit it). Node reads this with --env-file=.env.
# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PI_POCKET_TOKEN=replace-with-a-random-token-of-at-least-32-characters
PI_WORKSPACE=/absolute/path/to/your/project
PI_BIN=pi
PORT=8787
# Maximum active chats, 1–32 (default 8; one active request per chat).
# More children consume more RAM and provider capacity. There is no limit on saved chats.
PI_MAX_CONCURRENT=8
# New chat worktrees default to the freshly fetched remote default branch.
PI_GIT_REMOTE=origin
# Optional OFFLINE/local-only mode: explicitly name the local default branch.
# PI_DEFAULT_BRANCH=main
# Existing chat worktrees are reused without fetching/rebasing. Never delete them to free slots.
# Optional: JSON array of extra Pi flags. Never use --no-extensions here.
# Session-selection flags are rejected: the bridge owns per-chat context.
PI_ARGS=[]
