# Copy to .env (never commit it). Node reads this with --env-file=.env.
# Generate a token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PI_POCKET_TOKEN=replace-with-a-random-token-of-at-least-32-characters
PI_WORKSPACE=/absolute/path/to/your/project
PI_BIN=pi
PORT=8787
# Optional: maximum active chats, 1–8 (one active request per chat).
PI_MAX_CONCURRENT=3
# Optional: JSON array of extra Pi flags. Never use --no-extensions here.
# Session-selection flags are rejected: the bridge owns per-chat context.
PI_ARGS=[]
